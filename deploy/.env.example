CODERAI_PUBLIC_IP=203.0.113.10
CODERAI_CERTBOT_EMAIL=operations@example.com
CODERAI_LETSENCRYPT_DIR=/etc/letsencrypt
CODERAI_CERTBOT_WEBROOT=/srv/coderai/acme
CODERAI_UPDATE_DIR=/srv/coderai/updates
CODERAI_MONITORING_METRICS_DIR=/srv/coderai/metrics
CODERAI_DEFAULT_ORGANIZATION_CODE=coderai-pilot
CODERAI_DEFAULT_ORGANIZATION_NAME="CoderAI 试点机构"
CODERAI_MINIMUM_CLIENT_VERSION=0.2.0-beta.1
CODERAI_RELEASE_CHANNEL=beta
CODERAI_BUILD_COMMIT=replace-with-git-sha
# Optional Debian mirror base URL for constrained server networks.
CODERAI_APT_MIRROR=
# Optional Python package index URL for constrained server networks.
CODERAI_PIP_INDEX_URL=

POSTGRES_DB=coderai
POSTGRES_USER=coderai
POSTGRES_PASSWORD=replace-with-long-random-password
CODERAI_DATABASE_URL=postgresql+psycopg://coderai:replace-with-long-random-password@postgres:5432/coderai
CODERAI_REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=coderai-minio
MINIO_ROOT_PASSWORD=replace-with-long-random-password
CODERAI_S3_BUCKET=coderai-pilot
CODERAI_S3_ENDPOINT=http://minio:9000
CODERAI_S3_REGION=us-east-1
CODERAI_S3_ACCESS_KEY=coderai-minio
CODERAI_S3_SECRET_KEY=replace-with-long-random-password
CODERAI_S3_SECURE=false

# Generate with: python -m backend.app.cli generate-secret-key
CODERAI_SECRET_KEY=replace-with-base64-32-byte-key
CODERAI_SECRET_KEY_PREVIOUS=

# Must point to storage independent from the production data disk/MinIO.
CODERAI_BACKUP_ENABLED=true
CODERAI_BACKUP_S3_ENDPOINT=https://backup-object-storage.example.cn
CODERAI_BACKUP_S3_BUCKET=coderai-backups
CODERAI_BACKUP_S3_ACCESS_KEY=replace-me
CODERAI_BACKUP_S3_SECRET_KEY=replace-me
CODERAI_BACKUP_S3_REGION=cn-east-1

CODERAI_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
CODERAI_JSON_LOGS=true
CODERAI_LOG_LEVEL=INFO
CODERAI_API_WORKERS=2
CODERAI_CELERY_CONCURRENCY=2

# Optional HTTPS webhook. When empty, alerts remain visible in Alertmanager but are not delivered externally.
CODERAI_ALERT_WEBHOOK_URL=
