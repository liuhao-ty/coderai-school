{
  "name": "coderai-kids-ai-suite",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "python -m uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "tsc && vite build",
    "test": "python -m unittest discover -s tests -v",
    "lint:backend": "python -m ruff check backend tests deploy tools/pilot-load-test.py",
    "test:tauri": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ppt-conversion": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-libreoffice-conversion.ps1",
    "test:load": "python tools/pilot-load-test.py",
    "pretest:e2e": "node tests/e2e/prepare.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint:backend && npm run test && npm run build",
    "check:full": "npm run check && npm run test:tauri && npm run test:e2e",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "antd": "5.29.3",
    "axios": "1.18.1",
    "dayjs": "1.11.21",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.1",
    "reactflow": "11.11.4",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
